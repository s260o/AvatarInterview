GEMINI_API_KEY=your-gemini-api-key

# Optional model/voice overrides
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# 主モデルが混雑・タイムアウトした時に順に試すモデル（カンマ区切り）
GEMINI_CHAT_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.7-flash
# 1モデルあたりの待ち時間上限（秒）
GEMINI_CHAT_TIMEOUT_SEC=10
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_FALLBACK_MODELS=gemini-3.1-flash-tts-preview
GEMINI_TTS_TIMEOUT_SEC=15
GEMINI_TTS_VOICE=Charon
# CHAT の思考量（minimal/low/medium/high。モデルにより minimal 非対応）。低いほど速い
GEMINI_CHAT_THINKING_LEVEL=low

# 外部公開（Cloudflare Tunnel）用の認証トークン。空なら認証なし（このPC内だけで使う場合）
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unity 側の Assets/Resources/ServerSettings.json の apiKey と同じ値にする
API_TOKEN=

# オープンラボ（研究室公開）用のデモ設定。詳しくは OPEN_LAB.md
# OPEN_LAB_MODE は .env には書かず、start_openlab.cmd で起動したときだけ有効にする
# （.env に書くと本番の実験日に戻し忘れるおそれがあるため）。以下は必要なときだけ設定する
# デモ1回の長さ（秒）
#OPEN_LAB_DURATION_SEC=180
# 来場者の発話内容をログに残すか（来場者は研究参加の同意をしていないので、既定は残さない）
#OPEN_LAB_SAVE_TEXT=0
